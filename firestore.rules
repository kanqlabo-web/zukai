rules_version = '2';
// 舞台図解メーカー用のセキュリティルール（Googleドライブと同じ共有の考え方）
// Firebase コンソール → Firestore → ルール に、この内容をすべて貼り付けて「公開」してください。
service cloud.firestore {
  match /databases/{database}/documents {

    // Googleアカウントでログインしていれば、だれでも使える
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }

    // プロフィール（共有画面に名前を出すため）。メールアドレスを知っている人だけが1件ずつ読める
    match /profiles/{email} {
      allow get: if signedIn();
      allow write: if signedIn() && email == me();
    }

    // ---------- 作品の共有 ----------
    // participants：共有されている全員 / owners：オーナー / viewers：閲覧者（それ以外は編集者）
    function owners(d) { return d.get('owners', []); }
    function viewers(d) { return d.get('viewers', []); }
    function validShare(d) {
      return d.participants is list && owners(d) is list && viewers(d) is list
        && owners(d).size() > 0
        && d.participants.toSet().hasAll(owners(d).toSet())
        && d.participants.toSet().hasAll(viewers(d).toSet())
        && !owners(d).toSet().hasAny(viewers(d).toSet());
    }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function shareKeys() { return ['participants', 'owners', 'viewers', 'linkRole', 'linkKey', 'lastJoin']; }

    function workPath(w) { return /databases/$(database)/documents/works/$(w); }
    function inWork(w) {
      return signedIn() && exists(workPath(w)) && me() in get(workPath(w)).data.participants;
    }
    function canWrite(w) {
      return inWork(w) && !(me() in viewers(get(workPath(w)).data));
    }
    // 作品と中身を一度に作るとき用（書き込み後の状態で判定）
    function canWriteAfter(w) {
      return signedIn() && existsAfter(workPath(w))
        && me() in getAfter(workPath(w)).data.participants
        && !(me() in viewers(getAfter(workPath(w)).data));
    }

    match /works/{w} {
      allow read: if signedIn() && me() in resource.data.participants;

      // 作った人がオーナー
      allow create: if signedIn() && validShare(request.resource.data)
        && request.resource.data.participants == [me()]
        && owners(request.resource.data) == [me()];

      // オーナー：共有設定を含めて何でも変えられる
      allow update: if signedIn() && me() in owners(resource.data)
        && validShare(request.resource.data);

      // 編集者：共有設定以外を変えられる
      allow update: if signedIn() && me() in resource.data.participants
        && !(me() in viewers(resource.data))
        && !changedKeys().hasAny(shareKeys());

      // リンクを知っている人が参加する（リンクの合言葉が必要）
      allow update: if signedIn() && !(me() in resource.data.participants)
        && resource.data.get('linkRole', 'off') in ['viewer', 'editor']
        && request.resource.data.lastJoin.by == me()
        && request.resource.data.lastJoin.key == resource.data.linkKey
        && changedKeys().hasOnly(['participants', 'viewers', 'lastJoin'])
        && request.resource.data.participants.toSet() == resource.data.participants.toSet().union([me()].toSet())
        && ((resource.data.linkRole == 'editor'
              && viewers(request.resource.data).toSet() == viewers(resource.data).toSet())
          || (resource.data.linkRole == 'viewer'
              && viewers(request.resource.data).toSet() == viewers(resource.data).toSet().union([me()].toSet())));

      // オーナー以外は、自分で共有から抜けられる
      allow update: if signedIn() && me() in resource.data.participants
        && !(me() in owners(resource.data))
        && changedKeys().hasOnly(['participants', 'viewers'])
        && request.resource.data.participants.toSet() == resource.data.participants.toSet().difference([me()].toSet())
        && viewers(request.resource.data).toSet() == viewers(resource.data).toSet().difference([me()].toSet());

      // 作品の削除はオーナーだけ
      allow delete: if signedIn() && me() in owners(resource.data);

      // 作品の中身：共有されている人は読める。閲覧者以外は書ける
      match /{sub=**} {
        allow read: if inWork(w);
        allow write: if canWrite(w) || canWriteAfter(w);
      }
    }
  }
}
